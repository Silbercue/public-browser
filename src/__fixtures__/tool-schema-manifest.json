                      "capture_image"
                    ],
                    "type": "string"
                  },
                  "question": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "tool": {
                "type": "string"
              }
            },
            "required": [
              "tool"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "use_operator": {
          "default": false,
          "type": "boolean"
        },
        "vars": {
          "additionalProperties": {},
          "type": "object"
        }
      },
      "type": "object"
