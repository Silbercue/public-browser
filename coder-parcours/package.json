{
  "name": "coder-parcours",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "vite build --config app/vite.config.ts",
    "start": "./start.sh",
    "start:hosted": "mkdir -p data && node server/start.mjs --hosted --port ${PORT:-8080} --reports data/reports.jsonl --admin-token-env CODER_PARCOURS_ADMIN_TOKEN",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "node --test \"catalog/**/*.test.mjs\" \"server/**/*.test.mjs\" \"harness/**/*.test.mjs\"",
    "e2e": "npm run build && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
